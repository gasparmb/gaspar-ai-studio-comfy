# AI STUDIO — variables d'environnement (toutes facultatives : les valeurs ci-dessous sont celles par défaut)
#
# L'app ne lit pas de fichier .env. Les variables se passent au lancement :
#     PORT=8190 HOST=127.0.0.1 ./lancer.sh
#     COMFY_DIR=/chemin/vers/ComfyUI ./installer.sh
# Une ligne commentée (#) est facultative : sans elle, le code applique le défaut indiqué à côté.

# === Application (server.py) ===
PORT=8190                          # port de l'app (interface, API)
HOST=0.0.0.0                       # 0.0.0.0 : tout le réseau local ; 127.0.0.1 : la machine seule
SHARE_PORT=8191                    # site des liens clients : le seul port publiable
# PUBLIC_URL=                        # adresse publique des liens clients ; vide : déduite de Tailscale Funnel
# DATA_DIR=                          # dossier des données (comptes, historique, projets) ; vide : data/ dans le dépôt
AUTH_LOCAL_BYPASS=1                # 1 : les requêtes venues de la machine elle-même passent sans compte ; 0 : elles aussi se connectent

# === ComfyUI ===
COMFY_URL=http://127.0.0.1:8188    # adresse de l'API ComfyUI
COMFY_DIR=~/ComfyUI                # dossier d'installation de ComfyUI (modèles, sorties)
# COMFY_PY=                          # Python de ComfyUI (lancer.sh) ; vide : trouvé dans COMFY_DIR (.venv ou venv)
COMFYUI_LISTEN=127.0.0.1           # adresse d'écoute de ComfyUI lancé depuis l'app (installation, petite app de bureau)
# AIS_COMFY_PORT=                    # port lancé par l'installation ; vide : port de COMFY_URL, sinon 8188
# QWEN_ATTENTION=                    # vide : rien ne change ; « pytorch attention » contourne SageAttention 1.x (images Qwen noires)

# === Assistant local (assistant.py, installation.py) ===
AIS_ASSISTANT_URL=http://127.0.0.1:11435   # serveur Ollama de l'assistant
AIS_ASSISTANT_MODEL=qwen3-vl:8b            # modèle de vision de l'assistant
AIS_ASSISTANT_CTX=16384                    # taille de contexte de l'assistant
# AIS_OLLAMA_PORT=                           # port lancé par l'installation ; vide : port de AIS_ASSISTANT_URL, sinon 11435
AIS_OLLAMA_DIR=~/ollama                    # dossier du binaire Ollama installé sans sudo
AIS_OLLAMA_MODELS=~/.ollama-recent/models  # dossier des modèles Ollama
